# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 지울 파일을 임시로 옮겨 두는 폴더 (사용자가 직접 확인 후 삭제)
/trash-can/

# 빌드 때마다 node_modules에서 복사되는 exceljs 사본 (Worker가 사용)
/public/vendor/

# bkit 작업 기록(내 PC 경로 등이 들어 있음)
/.bkit/

# Claude Code 로컬 설정·작업 메모(내 PC 경로 등이 들어 있음)
/.claude/

# 폐쇄망 반출용 묶음(빌드 결과물)
/offline-dist/

# 오피스 프로그램이 만드는 임시 잠금 파일
.~lock.*
